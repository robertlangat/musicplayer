<?xml version="1.0" encoding="utf-8"?>
<!-- Album Player (2x2): full-bleed artwork, scrim, title and prev/play/next. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_album">

    <ImageView
        android:id="@+id/w_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/artwork"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_w_note" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_scrim"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/w_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/nothing_playing"
            android:textColor="@color/widget_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/w_prev"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/previous"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_w_prev" />

            <ImageButton
                android:id="@+id/w_play"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/widget_btn_circle"
                android:contentDescription="@string/play"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_w_play" />

            <ImageButton
                android:id="@+id/w_next"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/next"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_w_next" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
